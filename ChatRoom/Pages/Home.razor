@page "/"
@inject IThreadApiClient ThreadApi
@inject ThreadUpdatesClient ThreadUpdates
@inject ILogger<Home> Logger
@implements IAsyncDisposable

<PageTitle>Hilos | ChatRoom</PageTitle>

<MudStack Spacing="5">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="page-heading">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">CONVERSACIONES</MudText>
            <MudText Typo="Typo.h3" Class="heading-title">Hilos recientes</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Explora lo que está hablando la comunidad.</MudText>
        </div>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshThreads">
                Actualizar
            </MudButton>
            <AuthorizeView>
                <Authorized>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="ToggleCreateForm">
                        Nuevo hilo
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="/login?returnUrl=%2F"
                               Variant="Variant.Filled"
                               Color="Color.Primary">
                        Inicia sesión para publicar
                    </MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </MudStack>
    </MudStack>

    <AuthorizeView>
        <Authorized>
            <MudCollapse Expanded="_showCreateForm">
                <MudPaper Elevation="0" Outlined="true" Class="create-thread-panel">
                    <MudStack Spacing="3">
                        <MudStack>
                            <MudText Typo="Typo.h6">Iniciar una conversación</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                El hilo se asociará a tu cuenta.
                            </MudText>
                        </MudStack>
                        <MudForm @ref="_createForm">
                            <MudStack Spacing="2">
                                <MudTextField T="string"
                                              Label="Título"
                                              Placeholder="¿De qué quieres hablar?"
                                              Variant="Variant.Outlined"
                                              @bind-Value="_newThread.Title"
                                              Required="true"
                                              RequiredError="El título es obligatorio."
                                              Disabled="_isCreating" />
                                <MudTextField T="string"
                                              Label="Descripción"
                                              Placeholder="Agrega contexto a tu hilo"
                                              Variant="Variant.Outlined"
                                              Lines="3"
                                              @bind-Value="_newThread.Description"
                                              Required="true"
                                              RequiredError="La descripción es obligatoria."
                                              Disabled="_isCreating" />
                                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                                    <MudButton Variant="Variant.Text"
                                               Disabled="_isCreating"
                                               OnClick="ToggleCreateForm">
                                        Cancelar
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Send"
                                               Disabled="_isCreating"
                                               OnClick="CreateThread">
                                        @(_isCreating ? "Publicando..." : "Publicar hilo")
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </MudForm>
                    </MudStack>
                </MudPaper>
            </MudCollapse>
        </Authorized>
    </AuthorizeView>

    @if (_createError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @_createError
        </MudAlert>
    }

    @if (_createSuccess is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
            @_createSuccess
        </MudAlert>
    }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" ShowCloseIcon="true">
            @_loadError
        </MudAlert>
    }

    @if (_realtimeError is not null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" ShowCloseIcon="true">
            @_realtimeError
        </MudAlert>
    }

    <MudPaper Elevation="0" Outlined="true" Class="threads-panel">
        <MudTable @ref="_table"
                  T="ThreadItem"
                  ServerData="LoadThreads"
                  Dense="true"
                  Hover="true"
                  LoadingProgressColor="Color.Primary"
                  RowsPerPage="10"
                  Breakpoint="Breakpoint.Sm"
                  Class="threads-table">
            <HeaderContent>
                <MudTh>Hilo</MudTh>
                <MudTh>Autor</MudTh>
                <MudTh>Creado</MudTh>
                <MudTh Class="text-end">Respuestas</MudTh>
                <MudTh>Última respuesta</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Hilo">
                    <MudStack Spacing="0">
                        <MudLink Href="@($"/threads/{context.Id}")"
                                 Typo="Typo.subtitle1"
                                 Color="Color.Inherit"
                                 Underline="Underline.Hover"
                                 Class="thread-title">
                            @context.Title
                        </MudLink>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="thread-description">
                            @context.Description
                        </MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Autor">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        @if (!string.IsNullOrWhiteSpace(context.AuthorProfile?.Image))
                        {
                            <MudAvatar Size="Size.Small">
                                <MudImage Src="@context.AuthorProfile.Image" Alt="@context.AuthorProfile.Username" />
                            </MudAvatar>
                        }
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @(context.AuthorProfile?.Username ?? $"Usuario #{context.Author}")
                        </MudChip>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Creado">@FormatDate(context.Created)</MudTd>
                <MudTd DataLabel="Respuestas" Class="text-end">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(context.ReplyCount > 0 ? Color.Primary : Color.Default)"
                             Variant="Variant.Filled">
                        @context.ReplyCount
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Última respuesta">
                    @(context.LastReplyTimestamp is DateTime lastReply ? FormatDate(lastReply) : "Sin respuestas")
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @if (_loadError is null)
                {
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="empty-state">
                        <MudIcon Icon="@Icons.Material.Outlined.Forum" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6">Todavía no hay hilos</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Cuando se creen, aparecerán aquí.</MudText>
                    </MudStack>
                }
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50, 100 }"
                               RowsPerPageString="Hilos por página"
                               InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private MudTable<ThreadItem>? _table;
    private MudForm? _createForm;
    private CreateThreadRequest _newThread = new();
    private bool _showCreateForm;
    private bool _isCreating;
    private string? _createError;
    private string? _createSuccess;
    private string? _loadError;
    private string? _realtimeError;

    protected override async Task OnInitializedAsync()
    {
        ThreadUpdates.ThreadChanged += HandleThreadChangedAsync;
        ThreadUpdates.Reconnected += HandleReconnectedAsync;

        try
        {
            await ThreadUpdates.SubscribeToThreadListAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Thread list real-time updates could not be started.");
            _realtimeError = "Las actualizaciones automáticas no están disponibles. Puedes actualizar la lista manualmente.";
        }
    }

    private async Task<TableData<ThreadItem>> LoadThreads(TableState state, CancellationToken cancellationToken)
    {
        _loadError = null;

        try
        {
            PagedResult<ThreadItem>? page = await ThreadApi.GetPageAsync(
                state.Page + 1,
                state.PageSize,
                cancellationToken);

            return new TableData<ThreadItem>
            {
                Items = page.Items,
                TotalItems = page.TotalCount
            };
        }
        catch (HttpRequestException e)
        {
            Console.WriteLine($"Error al cargar los hilos: {e.Message}");
            _loadError = "No se pudieron cargar los hilos. Comprueba que Thread.API esté en ejecución y disponible.";
            await InvokeAsync(StateHasChanged);
        }
        catch (System.Text.Json.JsonException)
        {
            _loadError = "Thread.API devolvió una respuesta que no se pudo interpretar.";
            await InvokeAsync(StateHasChanged);
        }

        return new TableData<ThreadItem>
        {
            Items = [],
            TotalItems = 0
        };
    }

    private async Task RefreshThreads()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private Task HandleThreadChangedAsync(int threadId, string changeType) =>
        InvokeAsync(RefreshThreads);

    private Task HandleReconnectedAsync() =>
        InvokeAsync(async () =>
        {
            _realtimeError = null;
            await RefreshThreads();
        });

    private void ToggleCreateForm()
    {
        _showCreateForm = !_showCreateForm;
        _createError = null;
        _createSuccess = null;
    }

    private async Task CreateThread()
    {
        if (_createForm is null || _isCreating)
        {
            return;
        }

        await _createForm.ValidateAsync();
        if (!_createForm.IsValid)
        {
            return;
        }

        _isCreating = true;
        _createError = null;
        _createSuccess = null;

        try
        {
            await ThreadApi.CreateAsync(_newThread);
            _newThread = new CreateThreadRequest();
            _showCreateForm = false;
            _createSuccess = "El hilo se creó correctamente.";
            _table?.NavigateTo(0);
            if (_table is not null)
            {
                await _table.ReloadServerData();
            }
        }
        catch (HttpRequestException exception)
        {
            _createError = exception.StatusCode is { } statusCode
                ? $"Thread.API rechazó la solicitud (HTTP {(int)statusCode}): {exception.Message}"
                : "No se pudo conectar con Thread.API. Comprueba que esté disponible e inténtalo nuevamente.";
        }
        catch (System.Text.Json.JsonException)
        {
            _createError = "Thread.API devolvió una respuesta que no se pudo interpretar.";
        }
        finally
        {
            _isCreating = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        ThreadUpdates.ThreadChanged -= HandleThreadChangedAsync;
        ThreadUpdates.Reconnected -= HandleReconnectedAsync;
        await ThreadUpdates.UnsubscribeFromThreadListAsync();
    }

    private static string FormatDate(DateTime date) =>
        date.ToLocalTime().ToString("dd MMM yyyy, HH:mm");
}
