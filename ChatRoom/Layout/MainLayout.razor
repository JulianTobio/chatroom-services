@inherits LayoutComponentBase
@inject ChatAuthStateProvider AuthState
@inject AuthApiClient AuthApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Surface" Class="chatroom-appbar">
        <MudLink Href="/" Typo="Typo.h6" Color="Color.Inherit" Underline="Underline.None" Class="brand-mark">
            ChatRoom
        </MudLink>
        <MudSpacer />
        <MudText Typo="Typo.body2" Color="Color.Secondary">Conversaciones de la comunidad</MudText>
        <AuthorizeView>
            <Authorized Context="auth">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="account-chip">
                    @auth.User.Identity?.Name
                </MudChip>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Disabled="_isSigningOut"
                           OnClick="SignOutAsync">
                    @(_isSigningOut ? "Cerrando..." : "Cerrar sesión")
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary">
                    Iniciar sesión
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="page-container">
            @if (AuthState.RestoreError is { } restoreError)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                    @restoreError
                </MudAlert>
            }
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isSigningOut;

    private async Task SignOutAsync()
    {
        if (_isSigningOut)
        {
            return;
        }

        _isSigningOut = true;
        try
        {
            await AuthApi.LogoutAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(
                "No se pudo confirmar el cierre de sesión en el servidor. La sesión local se cerró; vuelve a intentarlo si reaparece.",
                Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add(
                "Users.API tardó demasiado en cerrar la sesión. La sesión local se cerró; vuelve a intentarlo si reaparece.",
                Severity.Warning);
        }
        finally
        {
            AuthState.SignOut();
            _isSigningOut = false;
        }

        Navigation.NavigateTo("/login");
    }
}
